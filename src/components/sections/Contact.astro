---
import { basics } from "@cv";
import Section from "@/components/Section.astro";
import Mail from "@/icons/Mail.astro";
import Phone from "@/icons/Phone.astro";
import WhatsApp from "@/icons/WhatsApp.astro";
import GitHub from "@/icons/GitHub.astro";
import LinkedIn from "@/icons/LinkedIn.astro";

import Twitch from "@/icons/Twitch.astro";
import Youtube from "@/icons/Youtube.astro";
import TikTok from "@/icons/TikTok.astro";
import Facebook from "@/icons/Facebook.astro";

const { name, profiles, phone, email } = basics;

const whatsappNumber = phone?.replace(/[^\d]/g, "").replace(/^\+/, "") || "";
const whatsappUrl = whatsappNumber ? `https://wa.me/${whatsappNumber}` : "";

const SOCIAL_ICONS: Record<string, any> = {
  GitHub,
  LinkedIn,
  Twitch,
  Youtube,
  TikTok,
  Facebook,
};

---
<Section title="Contacto" id="section5" i18n="section.contact">
  <div class="flex flex-col items-center gap-16 mt-6">
    <!-- Versión de impresión: Enlaces y números de texto -->
    <div class="hidden print:flex flex-col gap-4 w-full text-sm text-gray-800 font-medium">
      {email && (
        <p class="flex items-center gap-3">
          <span class="font-black uppercase tracking-widest text-[10px] text-gray-500 min-w-[100px]">Email:</span> {email}
        </p>
      )}
      {phone && (
        <p class="flex items-center gap-3">
          <span class="font-black uppercase tracking-widest text-[10px] text-gray-500 min-w-[100px]">Teléfono:</span> {phone}
        </p>
      )}
      {profiles.map(({ network, url }) => (
        <p class="flex items-center gap-3">
          <span class="font-black uppercase tracking-widest text-[10px] text-gray-500 min-w-[100px]">{network}:</span> {url}
        </p>
      ))}
    </div>

    <!-- Redes y Contacto Directo -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 w-full no-print">
      {
        email && (
          <a
            class="group relative flex flex-col items-center gap-4 p-6 bg-white/5 border border-white/10 rounded-3xl hover:bg-white/10 hover:border-cyan-500 transition-transform duration-300 hover:-translate-y-1 will-change-transform shadow-xl hover:shadow-cyan-500/10"
            href={`mailto:${email}`}
            data-i18n-title="email.tooltip"
            title={`Enviar correo electronico a ${name}`}
            target="_blank"
            rel="noopener noreferrer"
          >
            <div class="p-3 bg-cyan-500/10 rounded-2xl group-hover:scale-110 transition-transform duration-300 will-change-transform">
              <Mail />
            </div>
            <span class="text-[10px] font-black uppercase tracking-[0.2em] text-gray-500 group-hover:text-cyan-400 transition-colors" data-i18n="contact.email">Correo</span>
          </a>
        )
      }
      {
        phone && (
          <a
            class="group relative flex flex-col items-center gap-4 p-6 bg-white/5 border border-white/10 rounded-3xl hover:bg-white/10 hover:border-cyan-500 transition-transform duration-300 hover:-translate-y-1 will-change-transform shadow-xl hover:shadow-cyan-500/10"
            href={`tel:${phone}`}
            data-i18n-title="phone.tooltip"
            title={`Llamar a ${name}`}
            target="_blank"
            rel="noopener noreferrer"
          >
            <div class="p-3 bg-cyan-500/10 rounded-2xl group-hover:scale-110 transition-transform duration-300">
              <Phone />
            </div>
            <span class="text-[10px] font-black uppercase tracking-[0.2em] text-gray-500 group-hover:text-cyan-400 transition-colors" data-i18n="contact.phone">Teléfono</span>
          </a>
        )
      }
      {
        profiles
          .filter(({ network }) => SOCIAL_ICONS[network])
          .map(({ network, url }) => {
            const Icon = SOCIAL_ICONS[network];
            return (
                <a
                  class="group relative flex flex-col items-center gap-4 p-6 bg-white/5 border border-white/10 rounded-3xl hover:bg-white/10 hover:border-cyan-500 transition-transform duration-300 hover:-translate-y-1 will-change-transform shadow-xl hover:shadow-cyan-500/10"
                  href={`${url}`}
                  title={`Perfil de ${network}`}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <div class="p-3 bg-cyan-500/10 rounded-2xl group-hover:scale-110 transition-transform duration-300 will-change-transform">
                  <Icon />
                </div>
                <span class="text-[10px] font-black uppercase tracking-[0.2em] text-gray-500 group-hover:text-cyan-400 transition-colors">{network}</span>
              </a>
            );
          })
      }
    </div>

    <!-- CTA de contratación -->
    <div class="w-full no-print">
      <div class="bg-gradient-to-br from-cyan-900/10 via-slate-900/40 to-blue-900/10 border border-white/5 rounded-[2.5rem] p-8 md:p-12 backdrop-blur-sm overflow-hidden relative group">
        <div class="absolute -top-24 -right-24 w-64 h-64 bg-cyan-600/10 rounded-full blur-3xl group-hover:bg-cyan-600/20 transition-colors duration-700"></div>
        <div class="absolute -bottom-24 -left-24 w-64 h-64 bg-blue-600/10 rounded-full blur-3xl group-hover:bg-blue-600/20 transition-colors duration-700"></div>

        <div class="relative z-10 text-center mb-12">
          <h3 class="text-xs font-black uppercase tracking-[0.4em] text-cyan-400 mb-3" data-i18n="contact.cta.subtitle">Disponible para proyectos freelance y colaboraciones</h3>
          <p class="text-2xl md:text-3xl font-black text-white tracking-tighter mb-4" data-i18n="contact.cta.title">¿Buscas un desarrollador?</p>
          <p class="text-sm text-gray-400 font-medium max-w-md mx-auto leading-relaxed" data-i18n="contact.cta.desc">Cuéntame tu proyecto y te respondo en menos de 24 horas.</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 relative z-10">
          {whatsappUrl && (
            <a
              href={whatsappUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="group flex flex-col items-center justify-center gap-3 w-full py-6 bg-[#25D366]/15 border border-[#25D366]/40 text-white text-xs font-black uppercase tracking-widest rounded-2xl hover:bg-[#25D366]/25 hover:border-[#25D366] transition-colors duration-300 shadow-xl"
            >
              <WhatsApp />
              <span class="text-sm font-black normal-case tracking-normal" data-i18n="contact.cta.whatsapp">WhatsApp</span>
              <span class="text-[10px] font-bold uppercase tracking-widest text-gray-400">{phone}</span>
            </a>
          )}
          {email && (
            <a
              href={`mailto:${email}?subject=${encodeURIComponent("Propuesta de proyecto")}`}
              target="_blank"
              rel="noopener noreferrer"
              class="flex flex-col items-center justify-center gap-3 w-full py-6 bg-white text-black text-xs font-black uppercase tracking-widest rounded-2xl hover:bg-cyan-500 hover:text-white transition-colors duration-300 shadow-xl"
            >
              <span class="text-sm font-black normal-case tracking-normal" data-i18n="contact.cta.hire">Contratarme</span>
              <span class="text-[10px] font-bold uppercase tracking-widest text-gray-500 group-hover:text-white" data-i18n="contact.cta.email">Escribir por correo</span>
            </a>
          )}
          {phone && (
            <a
              href={`tel:${phone}`}
              target="_blank"
              rel="noopener noreferrer"
              class="flex flex-col items-center justify-center gap-3 w-full py-6 bg-black/40 border border-white/10 text-white text-xs font-black uppercase tracking-widest rounded-2xl hover:border-cyan-500 hover:bg-cyan-600/20 transition-colors duration-300 shadow-xl"
            >
              <span class="text-sm font-black normal-case tracking-normal" data-i18n="contact.cta.phone">Llamar</span>
              <span class="text-[10px] font-bold uppercase tracking-widest text-gray-500">{phone}</span>
            </a>
          )}
        </div>
      </div>
    </div>
  </div>
</Section>
