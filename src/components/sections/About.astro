---
import Section from "../Section.astro";
import { basics, projects } from "@cv";
const { summary } = basics;
const tags = Array.from(new Set(projects.flatMap((p) => p.highlights)));
---

<Section title="Acerca de mi" id="section4" i18n="section.about">
  <div class="space-y-12">
    <p class="text-lg text-gray-300 leading-relaxed font-medium" data-i18n="about.summary">
      {summary}
    </p>

    <div class="space-y-6">
      <h3 class="text-xs font-black uppercase tracking-[0.3em] text-cyan-400 text-center" data-i18n="about.subtitle">
        Tecnologías & Herramientas
      </h3>
      
      <ul class="flex flex-wrap justify-center gap-4">
        {tags.map((tag) => (
          <li class="group relative px-6 py-2 bg-white/5 border border-white/10 rounded-2xl hover:bg-white/10 hover:border-cyan-500 transition-transform duration-300 hover:-translate-y-1 will-change-transform">
            <span class="text-xs font-black text-gray-300 group-hover:text-white transition-colors uppercase tracking-[0.1em]">{tag}</span>
            <div class="absolute -inset-0.5 bg-gradient-to-r from-cyan-600 to-blue-600 rounded-2xl blur opacity-0 group-hover:opacity-20 transition-opacity"></div>
          </li>
        ))}
      </ul>
    </div>

    <div class="space-y-6">
      <h3 class="text-xs font-black uppercase tracking-[0.3em] text-cyan-400 text-center" data-i18n="about.ai.title">
        Flujo de trabajo con IA
      </h3>

      <p class="text-base text-gray-400 leading-relaxed font-medium text-center max-w-2xl mx-auto" data-i18n="about.ai.summary">
        Integro IA en mi flujo diario como tecnología de trabajo: opencode como CLI agéntico dentro de mi IDE, con subagentes especializados en arquitectura, calidad, rendimiento, UX y producto, loops con criterios de salida y un harness de automejora. Cada cambio pasa por revisión y verificación humana antes de integrarse.
      </p>

      <ul class="flex flex-col gap-3 max-w-xl mx-auto">
        {[
          ["about.ai.item1","opencode: CLI agéntico integrado en mi IDE"],
          ["about.ai.item2","Subagentes especializados en arquitectura, calidad, rendimiento y UX"],
          ["about.ai.item3","Loops con criterios de salida y control de costos"],
          ["about.ai.item4","Harness de automejora con verificación humana"],
        ].map(([key, label]) => (
          <li class="flex items-center gap-3 text-sm text-slate-300 leading-relaxed">
            <span class="text-cyan-500 shrink-0">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
            </span>
            <span data-i18n={key}>{label}</span>
          </li>
        ))}
      </ul>
    </div>

    <!-- Banner para la animación de lluvia de palabras -->
    <div class="word-rain-banner mask-fade-y border-t border-b border-white/5">
      {tags.map((tag) => <span class="falling-word text-cyan-400 font-black uppercase tracking-[0.2em] pointer-events-none">{tag}</span>)}
    </div>
  </div>
</Section>

<style>
  .word-rain-banner {
    position: relative;
    width: 100%;
    height: 140px;
    overflow: hidden;
  }

  .mask-fade-y {
    mask-image: linear-gradient(to bottom, transparent, black 15%, black 85%, transparent);
    -webkit-mask-image: linear-gradient(to bottom, transparent, black 15%, black 85%, transparent);
  }

  .falling-word {
    position: absolute;
    top: 0;
    left: 0;
    font-size: 0.85rem;
    animation: fall 15s linear infinite;
    animation-fill-mode: backwards;
    opacity: 0;
    white-space: nowrap;
    will-change: transform, opacity;
  }

  @keyframes fall {
    0% {
      transform: translateY(-60px) scale(0.8);
      opacity: 0;
    }
    15% {
      opacity: 0.7;
      transform: translateY(10px) scale(1.1);
    }
    85% {
      opacity: 0.7;
      transform: translateY(110px) scale(1.1);
    }
    100% {
      transform: translateY(200px) scale(0.8);
      opacity: 0;
    }
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const words = document.querySelectorAll(".falling-word");

    words.forEach((word) => {
      const el = word as HTMLElement;
      const delay = Math.random() * 15;
      const leftPosition = Math.random() * 90 + 5;
      const size = 0.7 + Math.random() * 0.6;
      const colors = ['#06b6d4', '#3b82f6', '#f59e0b', '#ffffff'];
      const randomColor = colors[Math.floor(Math.random() * colors.length)];

      el.style.animationDelay = `${delay}s`;
      el.style.left = `${leftPosition}%`;
      el.style.fontSize = `${size}rem`;
      el.style.color = randomColor;
    });
  });
</script>
